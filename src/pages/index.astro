---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsappButton from '../components/WhatsappButton.astro';
import CtaBand from '../components/CtaBand.astro';
import HexMark from '../components/HexMark.astro';
import { CONTACT } from '../consts';

const areas = (await getCollection('areas', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const homeAreas = areas.slice(0, 6);
---

<BaseLayout
  title="Advocacia previdenciária em Gravataí"
  description="Advocacia especializada em Direito Previdenciário em Gravataí/RS. Aposentadorias, auxílio por incapacidade, BPC/LOAS e revisão de benefícios do INSS. Atendimento presencial na região e on-line."
>
  <section class="hero">
    <div class="wrap grid">
      <div>
        <p class="kicker">Direito Previdenciário · Gravataí / RS</p>
        <h1>Seus direitos junto ao INSS, tratados com técnica e com calma.</h1>
        <p class="lead">
          Aposentadorias, auxílios por incapacidade e benefícios assistenciais — do primeiro
          contato até a decisão, com linguagem que você entende.
        </p>
        <div class="actions">
          <WhatsappButton />
          <a class="tlink" href="/areas">Ver áreas de atuação</a>
        </div>
        <p class="meta">
          Atendimento presencial em Gravataí e região. On-line para todo o Brasil.
          Resposta em até 24 horas úteis.
        </p>
      </div>
      <div class="figure" aria-hidden="true">
        <HexMark size={120} color="var(--color-gold-line)" />
        <span>Imagem do escritório a definir</span>
      </div>
    </div>
  </section>

  <section class="rule-top block">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="kicker">Atuação</p>
          <h2>Trabalhamos exclusivamente com benefícios do INSS</h2>
        </div>
        <a class="tlink" href="/areas">Todas as áreas</a>
      </div>
      <ul class="svc-list">
        {
          homeAreas.map((a) => (
            <li class="svc">
              <div class="svc-name">
                <h3>{a.data.shortTitle}</h3>
                {a.data.featured && <span class="tag">Principal</span>}
              </div>
              <p>{a.data.summary}</p>
              <a class="tlink" href={`/areas/${a.id}`}>Detalhes</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="rule-top block tint">
    <div class="wrap grid">
      <div>
        <p class="kicker">Quando procurar</p>
        <h2>Situações em que vale conversar</h2>
        <p class="lead" style="font-size:1.1rem;margin-top:1rem">
          Se você se identifica com alguma delas, analisamos o seu caso e explicamos os
          próximos passos, sem compromisso.
        </p>
      </div>
      <ul class="when">
        <li>O INSS negou o seu pedido de benefício</li>
        <li>O benefício foi cessado e você continua incapaz</li>
        <li>Você tem dúvida sobre o melhor momento para se aposentar</li>
        <li>A perícia médica foi marcada e você não sabe como se preparar</li>
        <li>O valor do seu benefício parece menor do que deveria</li>
        <li>Você trabalhou na roça ou exposto a agente nocivo e isso não foi contado</li>
      </ul>
    </div>
  </section>

  <section class="rule-top block">
    <div class="wrap">
      <p class="kicker">Como funciona</p>
      <h2>Três passos, no seu ritmo</h2>
      <ol class="steps">
        <li>
          <span class="n">Passo 01</span>
          <h3>Primeiro contato</h3>
          <p>Você fala com o escritório pelo WhatsApp ou pessoalmente e conta o seu caso. Ouvimos com calma.</p>
        </li>
        <li>
          <span class="n">Passo 02</span>
          <h3>Análise dos documentos</h3>
          <p>Examinamos o extrato do CNIS, laudos e o histórico de requerimentos para entender quais direitos existem.</p>
        </li>
        <li>
          <span class="n">Passo 03</span>
          <h3>Estratégia e acompanhamento</h3>
          <p>Definimos o caminho — administrativo ou judicial — e informamos você a cada movimento.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="rule-top block tint">
    <div class="wrap grid">
      <div class="figure" aria-hidden="true">
        <HexMark size={90} color="var(--color-gold-line)" />
        <span>Imagem do escritório a definir</span>
      </div>
      <div>
        <p class="kicker">O Escritório</p>
        <h2>Unidade, inteligência e harmonia</h2>
        <p>
          Desde 2004, dedicamos nossa atuação ao Direito Previdenciário. Nessa área lida-se
          com momentos importantes e delicados da vida das pessoas — por isso, unimos
          conhecimento técnico e atualização permanente a escuta atenta, acolhimento e clareza.
        </p>
        <p>
          Nosso propósito é uma advocacia próxima, transparente e responsável, em que cada
          cliente compreenda seus direitos e seja acompanhado com seriedade.
        </p>
        <a class="tlink" href="/sobre">Conhecer o escritório</a>
      </div>
    </div>
  </section>

  <section class="rule-top block">
    <div class="wrap">
      <p class="kicker">Clientes</p>
      <h2>O que dizem no Google</h2>
      <p class="rating"><span class="stars">★★★★★</span> 5,0 de 5 · 8 avaliações no Google</p>
      <div class="quotes">
        <blockquote>
          <p>“Advogadas muito competentes, responsáveis, inteligentes, compromisso com o cliente na defesa dos segurados do INSS. Recomendo de olhos fechados.”</p>
          <cite>Karoline · avaliação no Google</cite>
        </blockquote>
        <blockquote>
          <p>“Ótima advogada, cuida do caso do meu esposo há anos, é muito competente. Agora ela vai pegar um caso meu.”</p>
          <cite>Luciana R. · avaliação no Google</cite>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="rule-top block" style="padding-bottom:0">
    <div class="wrap">
      <p class="locline">
        Atendemos <strong>Gravataí</strong> e região — Cachoeirinha, Alvorada, Viamão, Glorinha
        e Porto Alegre — e acompanhamos on-line clientes de outras cidades e estados.
      </p>
    </div>
  </section>

  <CtaBand waText="Olá! Vim pelo site e gostaria de tirar uma dúvida sobre um benefício do INSS." />
</BaseLayout>

<style>
  .block { padding-block: 5rem; }
  .tint { background: var(--color-teal-pale); }
  .grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 3.5rem;
    align-items: center;
  }
  .hero { padding-block: 5.5rem 4.5rem; }
  .hero h1 { margin-bottom: 1.4rem; }
  .hero .lead { margin-bottom: 1.9rem; max-width: 32ch; }
  .actions { display: flex; gap: 1.1rem; align-items: center; flex-wrap: wrap; }
  .meta {
    margin-top: 1.6rem;
    font-size: 0.9375rem;
    color: var(--color-ink-soft);
    border-left: 2px solid var(--color-gold-line);
    padding-left: 1rem;
  }
  .figure {
    aspect-ratio: 5 / 4;
    border: 1px solid var(--color-rule);
    background: var(--color-teal-pale);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }
  .figure span {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  .sec-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .svc-list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--color-rule); }
  .svc {
    display: grid;
    grid-template-columns: 1fr 2fr auto;
    gap: 2.25rem;
    align-items: baseline;
    padding: 1.6rem 0.5rem;
    border-bottom: 1px solid var(--color-rule);
  }
  .svc:hover { background: rgba(156, 122, 60, 0.06); }
  .svc-name .tag {
    display: block;
    margin-top: 0.375rem;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold);
  }
  .svc p { font-size: 1rem; color: var(--color-ink-soft); margin: 0; }

  .when { columns: 2; column-gap: 2.5rem; list-style: none; padding: 0; margin: 0; }
  .when li {
    break-inside: avoid;
    margin-bottom: 1rem;
    padding-left: 1.4rem;
    position: relative;
    font-size: 1rem;
    color: var(--color-ink-soft);
  }
  .when li::before { content: '—'; position: absolute; left: 0; color: var(--color-gold); }

  .steps {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }
  .steps .n {
    display: block;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    color: var(--color-gold);
    border-bottom: 1px solid var(--color-gold-line);
    padding-bottom: 0.5rem;
    margin-bottom: 0.875rem;
  }
  .steps p { font-size: 1rem; color: var(--color-ink-soft); margin: 0.375rem 0 0; }

  .rating {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 0.875rem;
    color: var(--color-ink-soft);
    margin-top: 0.5rem;
  }
  .rating .stars { color: var(--color-gold); letter-spacing: 2px; }
  .quotes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-top: 0.75rem;
  }
  blockquote { margin: 0; }
  blockquote p {
    font-style: italic;
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--color-ink);
    margin: 0 0 1rem;
  }
  blockquote cite {
    font-family: var(--font-display);
    font-style: normal;
    font-size: 0.875rem;
    color: var(--color-ink-soft);
  }

  .locline {
    border-top: 1px solid var(--color-gold-line);
    padding-top: 1.4rem;
    font-size: 1.0625rem;
    color: var(--color-teal-deep);
    max-width: 70ch;
  }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .svc { grid-template-columns: 1fr; gap: 0.5rem; }
    .svc .tlink { justify-self: start; }
    .when { columns: 1; }
    .steps { grid-template-columns: 1fr; }
    .quotes { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    .sec-head { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
  }
</style>
