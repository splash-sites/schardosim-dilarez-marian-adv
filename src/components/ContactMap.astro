---
import { CONTACT } from '../consts';

const addr = `${CONTACT.address.street} - ${CONTACT.address.district}, ${CONTACT.address.city} - ${CONTACT.address.state}`;
const hasGeo = Boolean(CONTACT.geo.latitude && CONTACT.geo.longitude);
// Coordenadas do Perfil da Empresa quando existirem (fixa o alfinete no local
// exato); senão, geocodifica o endereço.
const q = hasGeo ? `${CONTACT.geo.latitude},${CONTACT.geo.longitude}` : addr;
const embedSrc = `https://www.google.com/maps?q=${encodeURIComponent(q)}&z=17&hl=pt-BR&output=embed`;
---

<figure class="map" data-map data-src={embedSrc}>
  <div class="map-placeholder" data-map-placeholder>
    <div class="map-art" aria-hidden="true">
      <span class="road h"></span>
      <span class="road v"></span>
      <svg class="pin" width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 22s-7-6-7-12a7 7 0 0 1 14 0c0 6-7 12-7 12z" />
        <circle cx="12" cy="10" r="2.6" fill="var(--color-paper)" />
      </svg>
      <span class="map-tag">{CONTACT.address.street} — {CONTACT.address.city}/{CONTACT.address.state}</span>
    </div>
    <div class="map-cover">
      <p>O mapa do Google carrega conteúdo e cookies de terceiros.</p>
      <button type="button" class="btn btn-wa map-load" data-map-load>Carregar o mapa</button>
      <p class="map-alt">
        <a href={CONTACT.mapsUrl} target="_blank" rel="noopener">Abrir no Google Maps</a>
      </p>
    </div>
  </div>
</figure>

<script>
  const KEY = 'sdm-consent';

  document.querySelectorAll<HTMLElement>('[data-map]').forEach((fig) => {
    const src = fig.dataset.src;
    if (!src) return;
    let loaded = false;

    const load = () => {
      if (loaded) return;
      loaded = true;
      const frame = document.createElement('iframe');
      frame.src = src;
      frame.title = 'Mapa — localização do escritório';
      frame.loading = 'lazy';
      frame.referrerPolicy = 'no-referrer-when-downgrade';
      frame.setAttribute('allowfullscreen', '');
      frame.className = 'map-frame';
      fig.replaceChildren(frame);
    };

    try {
      if (localStorage.getItem(KEY) === 'accepted') load();
    } catch {
      /* storage bloqueado — mantém o placeholder */
    }

    document.addEventListener('sdm:consent-accepted', load);
    fig.querySelector('[data-map-load]')?.addEventListener('click', load);
  });
</script>

<style>
  .map {
    margin: 0;
    border: 1px solid var(--color-rule);
    background: #eae6dc;
  }
  /* :global porque o <iframe> é criado via JS e não recebe o escopo do componente */
  :global(.map-frame) {
    display: block;
    width: 100%;
    height: 20rem;
    border: 0;
  }

  .map-placeholder {
    position: relative;
    height: 20rem;
    overflow: hidden;
  }
  .map-art {
    position: absolute;
    inset: 0;
    background-color: #eae6dc;
    background-image:
      linear-gradient(0deg, transparent 47px, #dcd6c8 48px),
      linear-gradient(90deg, transparent 47px, #dcd6c8 48px);
    background-size: 48px 48px;
  }
  .road { position: absolute; background: #f4f1e8; }
  .road.h { left: 0; right: 0; top: 55%; height: 10px; }
  .road.v { top: 0; bottom: 0; left: 58%; width: 10px; }
  .pin {
    position: absolute;
    left: 55%;
    top: 46%;
    transform: translate(-50%, -100%);
    color: var(--color-gold);
  }
  .map-tag {
    position: absolute;
    left: 0.875rem;
    bottom: 0.75rem;
    max-width: calc(100% - 1.75rem);
    background: rgba(247, 245, 240, 0.94);
    border: 1px solid var(--color-rule);
    padding: 0.375rem 0.625rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    color: var(--color-ink-soft);
  }

  .map-cover {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    text-align: center;
    padding: 1.5rem;
    background: rgba(247, 245, 240, 0.82);
    backdrop-filter: blur(1px);
  }
  .map-cover p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
    max-width: 32ch;
  }
  .map-cover .map-load { min-height: 2.75rem; }
  .map-alt a {
    font-family: var(--font-display);
    font-size: 0.85rem;
    border-bottom: 1px solid var(--color-gold-line);
    padding-bottom: 2px;
  }
</style>
