---
/**
 * Banner de consentimento (LGPD). Só armazena a escolha do visitante em
 * localStorage — nada de cookie de terceiros até haver "aceitar".
 * Ao aceitar, dispara o evento `sdm:consent-accepted` (usado pelo mapa).
 * Um clique em qualquer elemento com [data-consent-reset] reabre o banner.
 */
---

<aside class="cookie-consent" id="cookie-consent" aria-label="Aviso de cookies" hidden>
  <div class="cc-inner">
    <p class="cc-text">
      Este site usa apenas o armazenamento necessário para funcionar. O mapa do Google,
      quando carregado, usa cookies de terceiros — você decide se quer permitir.
      <a href="/politica-de-privacidade">Política de Privacidade</a>.
    </p>
    <div class="cc-actions">
      <button type="button" class="btn btn-out cc-btn" data-cc="reject">Recusar</button>
      <button type="button" class="btn btn-wa cc-btn" data-cc="accept">Aceitar</button>
    </div>
  </div>
</aside>

<script>
  const KEY = 'sdm-consent';
  const el = document.getElementById('cookie-consent');
  const root = document.documentElement;

  const read = () => {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  };
  const write = (v: string) => {
    try {
      localStorage.setItem(KEY, v);
    } catch {
      /* modo privado / storage bloqueado — segue sem persistir */
    }
  };
  const apply = (v: string | null) => {
    root.dataset.consent = v ?? 'unset';
    if (v) el?.setAttribute('hidden', '');
    else el?.removeAttribute('hidden');
  };

  apply(read());

  el?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-cc]');
    if (!btn) return;
    const value = btn.dataset.cc === 'accept' ? 'accepted' : 'rejected';
    write(value);
    apply(value);
    if (value === 'accepted') {
      document.dispatchEvent(new CustomEvent('sdm:consent-accepted'));
    }
  });

  document.addEventListener('click', (e) => {
    const reset = (e.target as HTMLElement).closest('[data-consent-reset]');
    if (!reset) return;
    e.preventDefault();
    try {
      localStorage.removeItem(KEY);
    } catch {
      /* ignora */
    }
    apply(null);
  });
</script>

<style>
  .cookie-consent {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    background: var(--color-teal-deep);
    color: rgba(255, 255, 255, 0.9);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 -10px 28px -14px rgba(12, 53, 56, 0.45);
  }
  .cc-inner {
    max-width: 72rem;
    margin-inline: auto;
    padding: 1rem 2.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .cc-text {
    margin: 0;
    flex: 1 1 28ch;
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .cc-text a {
    color: var(--color-gold-line);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cc-actions {
    display: flex;
    gap: 0.75rem;
    flex: 0 0 auto;
  }
  .cc-btn {
    min-height: 2.75rem;
    padding: 0.6rem 1.35rem;
    font-size: 0.9rem;
  }
  .cookie-consent .btn-out {
    border-color: rgba(255, 255, 255, 0.4);
    color: #fff;
  }
  .cookie-consent .btn-out:hover {
    border-color: var(--color-gold);
    color: var(--color-gold);
  }

  @media (max-width: 640px) {
    .cc-inner {
      padding: 1rem 1.25rem;
      gap: 0.9rem;
    }
    .cc-actions {
      width: 100%;
    }
    .cc-btn {
      flex: 1;
      justify-content: center;
    }
  }
</style>
